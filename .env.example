# 复制为 .env 后按需修改（.env 不要提交到版本库）

# 监听地址与端口（命令行参数可覆盖：python run.py --host 0.0.0.0 --port 9000）
# 宝塔上建议保持 127.0.0.1，由 Nginx 反向代理对外提供 HTTPS
ACME_HOST=127.0.0.1
ACME_PORT=8000

# 数据目录（数据库、证书文件、master.key）。留空则为项目下的 data/
#ACME_DATA_DIR=/www/server/pyproj/acme/data

# 主密钥：用于加密阿里云 AccessKeySecret。留空则自动生成 data/master.key
# 建议：手动填入一个 32 位以上的随机字符串，并把 .env 权限设为 600
#ACME_MASTER_KEY=please-replace-me-with-a-long-random-string

# 通过 HTTPS 访问时设为 1，登录 Cookie 会带 Secure 标记
ACME_COOKIE_SECURE=0

# 后台同时签发证书的任务数（保持 1-2，避免触发 CA 限流）
ACME_ISSUE_WORKERS=2
